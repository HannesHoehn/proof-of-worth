---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);

const defaultDescription =
  lang === 'en'
    ? 'Proof of Worth connects low time preference from Bitcoin economics with Buy-It-For-Life consumption: an open, source-based directory of products that hold their value.'
    : 'Proof of Worth verknüpft niedrige Zeitpräferenz aus der Bitcoin-Ökonomie mit Buy-It-For-Life-Konsum: ein offenes, quellenbasiertes Verzeichnis wertbeständiger Produkte.';

const { title, description = defaultDescription } = Astro.props as Props;

const pageTitle = title === 'Proof of Worth' ? title : `${title} · Proof of Worth`;
const skipLinkLabel = lang === 'en' ? 'Skip to content' : 'Zum Inhalt springen';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a href="#main" class="skip-link">{skipLinkLabel}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
