---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProductIllustration from '../../components/ProductIllustration.astro';
import ZapButton from '../../components/ZapButton.astro';
import NostrComments from '../../components/NostrComments.astro';
import { getCollection, render } from 'astro:content';
import { gesamtScore, scoreLabel, kategorieLabel, formatGarantie } from '../../lib/score';
import { getContributor } from '../../data/contributors';
import { getLangFromUrl, useTranslations, localeOfEntryId, slugOfEntryId } from '../../i18n/utils';

export async function getStaticPaths() {
  const alle = await getCollection('products');
  return alle
    .filter((entry) => localeOfEntryId(entry.id) === 'de')
    .map((entry) => ({
      params: { slug: slugOfEntryId(entry.id) },
      props: { entry },
    }));
}

const { entry } = Astro.props as { entry: any };
const d = entry.data;
const { Content } = await render(entry);
const score = gesamtScore(d.scores);
const slug = slugOfEntryId(entry.id);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const contributor = getContributor(d.autor);

const kriterien = [
  { key: 'reparierbarkeit', label: t('kriterium.reparierbarkeit') },
  { key: 'material', label: t('kriterium.material') },
  { key: 'garantie', label: t('kriterium.garantie') },
  { key: 'wiederverkaufswert', label: t('kriterium.wiederverkaufswert') },
] as const;
---

<BaseLayout title={d.name} description={d.tagline}>
  <section class="section section--tight">
    <div class="container product-head">
      <a href="/produkte" class="back-link">{t('produkt.zurueck')}</a>
      <div class="product-head__row">
        <div class="product-illustration-box">
          <ProductIllustration slug={slug} class="product-illustration-box__svg" />
        </div>
        <div class="product-head__text">
          <span class={`badge ${d.einordnung === 'empfehlung' ? 'badge--empfehlung' : 'badge--diskussion'}`}>
            {d.einordnung === 'empfehlung' ? t('badge.empfehlung') : t('badge.diskussion')}
          </span>
          <h1>{d.name}</h1>
          <p class="lede">{d.tagline}</p>
        </div>
        <div class="score-box">
          <span class="score-pill score-pill--lg">{score}</span>
          <span class="score-box__label">{scoreLabel(score, lang)}</span>
        </div>
      </div>
      <div class="meta-row">
        <span>{d.hersteller}</span>
        <span>·</span>
        <span>{kategorieLabel(d.kategorie, lang)}</span>
        <span>·</span>
        <span>{formatGarantie(d.garantieJahre, lang)}</span>
        <span>·</span>
        <span>ca. {d.typischerPreisEUR} € · {d.erwarteteLebensdauerJahre} Jahre erwartete Lebensdauer</span>
      </div>

      {d.kaufLink && (
        <div class="kauf-box">
          <a href={d.kaufLink} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
            {t('produkt.kaufen')} <Icon name="external" size={14} />
          </a>
          <p class="kauf-box__hinweis">{t('produkt.kaufHinweis')}</p>
        </div>
      )}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Score-Aufschlüsselung</h2>
      <div class="criteria">
        {kriterien.map((k) => (
          <div class="criterion">
            <div class="criterion__head">
              <span>{k.label}</span>
              <span class="criterion__val">{d.scores[k.key].wert}/5</span>
            </div>
            <div class="score-bar">
              <span style={`width:${(d.scores[k.key].wert / 5) * 100}%`}></span>
            </div>
            <p class="criterion__note">{d.scores[k.key].begruendung}</p>
          </div>
        ))}
      </div>
      <p class="criteria-footnote">
        Details zur Methodik: <a href="/score-methodik">Score-Methodik ansehen</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container article">
      <Content />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Quellen</h2>
      <ul class="sources">
        {d.quellen.map((q: any) => (
          <li>
            <a href={q.url} target="_blank" rel="noopener noreferrer">{q.label}</a>
          </li>
        ))}
      </ul>
      {d.langzeitberichte.length > 0 && (
        <>
          <h3>Langzeitberichte aus der Community</h3>
          <ul class="reports">
            {d.langzeitberichte.map((r: any) => (
              <li><strong>{r.seitJahren} Jahre im Einsatz</strong> — {r.autor}: {r.notiz}</li>
            ))}
          </ul>
        </>
      )}
      <p class="contribute-note">
        Nutzt du dieses Produkt schon seit Jahren? <a href="/mitmachen">Reiche einen Langzeitbericht per Pull Request ein.</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container zap-section">
      <h2>Diesen Beitrag unterstützen</h2>
      <p class="lede">
        Gute Produktanalysen entstehen durch Recherchezeit. Ein Zap geht direkt und ohne
        Umweg an die Person, die diesen Beitrag geschrieben hat.
      </p>
      <ZapButton lightningAddress={contributor.lightningAddress} autor={d.autor} />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container nostr-section">
      <NostrComments lang={lang} shareTitle={d.name} lightningAddress={contributor.lightningAddress} />
    </div>
  </section>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 1.2rem;
    color: var(--color-ink-soft);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .product-head__row {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
  }
  .product-illustration-box {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    border-radius: var(--radius-lg);
    background: var(--color-paper-dim);
    border: 1px solid var(--color-line);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .product-illustration-box__svg {
    width: 68px;
    height: 68px;
  }
  .product-head__text { flex: 1; min-width: 0; }
  .kauf-box { margin-top: 1.1rem; display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem; }
  .kauf-box .btn { display: inline-flex; align-items: center; gap: 0.4rem; }
  .kauf-box__hinweis { margin: 0; font-size: 0.78rem; color: var(--color-ink-soft); }
  .score-box {
    margin-left: auto;
    text-align: center;
    flex-shrink: 0;
  }
  .score-pill--lg { width: 3.4rem; height: 3.4rem; font-size: 1.3rem; }
  .score-box__label {
    display: block;
    font-size: 0.78rem;
    margin-top: 0.4rem;
    color: var(--color-ink-soft);
    font-weight: 600;
  }
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    margin-top: 1.2rem;
  }
  .criteria { display: flex; flex-direction: column; gap: 1.6rem; max-width: 760px; }
  .criterion__head {
    display: flex;
    justify-content: space-between;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .criterion__note {
    margin-top: 0.5rem;
    color: var(--color-ink-soft);
    font-size: 0.94rem;
  }
  .criteria-footnote { margin-top: 1.8rem; font-size: 0.9rem; }
  .article { max-width: 760px; }
  .article :global(h2) { margin-top: 2rem; }
  .sources, .reports { padding-left: 1.2rem; }
  .contribute-note { margin-top: 1.2rem; font-size: 0.94rem; color: var(--color-ink-soft); }
  .zap-section { max-width: 620px; }
  .zap-section .lede { margin-bottom: 1.2rem; }
  .nostr-section { max-width: 760px; }

  @media (max-width: 700px) {
    .product-head__row { flex-wrap: wrap; }
    .score-box { margin-left: 0; }
  }
</style>
