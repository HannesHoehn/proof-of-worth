---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const schritte = [
  {
    titel: 'Fork the repository',
    text: 'Create your own fork of the Proof of Worth repository using the GitHub button at the top right.',
  },
  {
    titel: 'Create a new product file',
    text: 'Copy an existing file from src/content/products/en/ as a template and save it under a descriptive filename (e.g. victorinox-pocket-knife.md).',
  },
  {
    titel: 'Fill in the fields',
    text: 'Enter the name, category, the four score criteria with reasoning, and at least one credible source. A submission without sources will not be merged.',
  },
  {
    titel: 'Open a pull request',
    text: 'Submit your change as a pull request. A preview build automatically shows what the new product page will look like.',
  },
  {
    titel: 'Review & merge',
    text: 'After a short review (score plausibility, sourcing), the PR is merged and goes live.',
  },
];
---

<BaseLayout
  title="Contribute"
  description="How to add a new product via GitHub or correct an existing rating."
>
  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">Community</span>
      <h1>Contribute via GitHub</h1>
      <p class="lede">
        Proof of Worth is built as an open project. Every product is a single markdown
        file with clear fields – contributions run through the normal GitHub workflow:
        fork, branch, pull request.
      </p>
      <a href="https://github.com/" class="btn btn--primary" target="_blank" rel="noopener noreferrer">
        <Icon name="github" size={18} /> Go to the repository
      </a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>How a contribution works</h2>
      <ol class="steps">
        {schritte.map((s, i) => (
          <li class="step">
            <span class="step__num">{i + 1}</span>
            <div>
              <h3>{s.titel}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Template for a new product file</h2>
      <p>
        This structure is also available as <code>_TEMPLATE.md</code> in the
        <code>src/content/products/</code> folder:
      </p>
      <pre class="code-block"><code>{`---
name: "Product name"
hersteller: "Manufacturer name"
kategorie: "werkzeug-outdoor" # or: haushalt-kueche, tech-hardware, bekleidung
tagline: "One sentence that positions the BIFL character."
einordnung: "empfehlung" # or: diskussionswuerdig
icon: "box"
scores:
  reparierbarkeit:
    wert: 4
    begruendung: "Why this value? Back it up with a source."
  material:
    wert: 4
    begruendung: "..."
  garantie:
    wert: 4
    begruendung: "..."
  wiederverkaufswert:
    wert: 3
    begruendung: "..."
garantieJahre: 5
typischerPreisEUR: 200
erwarteteLebensdauerJahre: 15
quellen:
  - label: "Manufacturer page – warranty terms"
    url: "https://..."
langzeitberichte: []
veroeffentlicht: 2026-08-09
autor: "Your name or GitHub handle"
---

## Why this product fits the concept

...

## Limitations

...

## Verdict

...
`}</code></pre>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>What makes a good contribution</h2>
      <ul class="checklist">
        <li><Icon name="check" size={18} /> Every score justification is backed by a verifiable, credible source (manufacturer page, iFixit, independent test).</li>
        <li><Icon name="check" size={18} /> Weaknesses are named too – a product doesn't need to be perfect to be included.</li>
        <li><Icon name="check" size={18} /> Long-term reports (5, 10, 20 years of use) are especially welcome and boost credibility enormously.</li>
        <li><Icon name="check" size={18} /> Corrections to existing ratings are explicitly encouraged – that's a pull request too.</li>
      </ul>
    </div>
  </section>

  <section id="lightning" class="section">
    <div class="container">
      <h2><Icon name="bolt" size={22} /> Adding a Lightning address</h2>
      <p class="lede">
        Every product page has a Zap button that lets readers support you directly via
        Lightning. To set it up, add an entry in
        <code>src/data/contributors.ts</code>:
      </p>
      <pre class="code-block"><code>{`export const contributors: Record<string, Contributor> = {
  Redaktion: { lightningAddress: undefined },
  "your-github-handle": {
    lightningAddress: "your-name@getalby.com",
    nostr: "npub1...", // optional, profile link only
  },
};`}</code></pre>
      <p>
        Then set <code>autor: "your-github-handle"</code> in your product files – the
        Zap button on that product's page will automatically point to your address.
        Without an entry, the page shows a notice instead of a broken button.
        Details: <a href="/en/unterstuetzen">Support page</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .steps { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.6rem; }
  .step { display: flex; gap: 1rem; }
  .step__num {
    flex-shrink: 0;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--color-bronze);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-family: var(--font-display);
  }
  .step h3 { margin-bottom: 0.3rem; font-size: 1.05rem; }
  .step p { margin: 0; color: var(--color-ink-soft); }

  .code-block {
    background: var(--color-ink);
    color: #e7e0d2;
    padding: 1.4rem;
    border-radius: var(--radius-lg);
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.55;
  }
  code { font-family: 'SFMono-Regular', Consolas, Menlo, monospace; }

  .checklist { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .checklist li { display: flex; align-items: flex-start; gap: 0.6rem; }
  .checklist :global(svg) { color: var(--color-moss-dark); margin-top: 0.15rem; flex-shrink: 0; }
  #lightning h2 { display: flex; align-items: center; gap: 0.55rem; }
  #lightning h2 :global(svg) { color: var(--color-bronze); }
  #lightning .lede { margin-bottom: 1.2rem; }
</style>
