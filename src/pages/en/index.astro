---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection } from 'astro:content';
import { gesamtScore, kategorieLabel } from '../../lib/score';
import { getLangFromUrl, localeOfEntryId } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const alle = await getCollection('products');
const alleProdukte = alle.filter((e) => localeOfEntryId(e.id) === lang);
const topProdukte = [...alleProdukte]
  .sort((a, b) => gesamtScore(b.data.scores) - gesamtScore(a.data.scores))
  .slice(0, 6);

const kategorieIcons: Record<string, string> = {
  'werkzeug-outdoor': 'wrench',
  'haushalt-kueche': 'home',
  'tech-hardware': 'cpu',
  bekleidung: 'shirt',
};
const kategorien = Object.keys(kategorieIcons).map((key) => {
  const count = alleProdukte.filter((p) => p.data.kategorie === key).length;
  return { key, label: kategorieLabel(key, lang), icon: kategorieIcons[key], count };
});

const anzahlEmpfehlung = alleProdukte.filter((p) => p.data.einordnung === 'empfehlung').length;
const anzahlDiskussion = alleProdukte.filter((p) => p.data.einordnung === 'diskussionswuerdig').length;
---

<BaseLayout title="Proof of Worth">
  <section class="hero">
    <div class="container hero__inner">
      <span class="eyebrow">Low Time Preference × Buy It For Life</span>
      <h1>Fiat money tempts you into quick consumption. <br />We look for what doesn't.</h1>
      <p class="lede">
        Proof of Worth is an open, source-based directory of products that hold their value
        for decades – curated by transparent criteria instead of marketing seals, and
        maintained by the community on GitHub.
      </p>
      <div class="hero__actions">
        <a href="/en/produkte" class="btn btn--primary">
          <Icon name="filter" size={16} /> Browse products
        </a>
        <a href="/en/score-methodik" class="btn btn--ghost">How we score</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">The idea behind it</span>
      <div class="grid grid--2 idea-grid">
        <div class="card">
          <h3><Icon name="bitcoin" size={18} /> For Bitcoiners &amp; economics-minded readers</h3>
          <p>
            Anyone who thinks in a hard currency weighs spending by opportunity cost: how
            many sats does this cost me – and what will it still be worth in 10 years? Proof
            of Worth translates that mindset into a concrete purchase decision.
          </p>
        </div>
        <div class="card">
          <h3>For sustainability- and quality-minded consumers</h3>
          <p>
            Instead of greenwashing seals, we rely on physical durability, repairability and
            timeless usability – a curated filter against the flood of cheap imports.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">By category</span>
      <h2>Categories</h2>
      <div class="grid grid--4">
        {kategorien.map((k) => (
          <a href={`/en/produkte?kategorie=${k.key}`} class="kat-card">
            <Icon name={k.icon} size={26} />
            <span class="kat-card__label">{k.label}</span>
            <span class="kat-card__count">{k.count} product{k.count === 1 ? '' : 's'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Proof-of-Worth score</span>
          <h2>Top-rated products</h2>
        </div>
        <a href="/en/produkte" class="btn btn--ghost">View all</a>
      </div>
      <div class="grid grid--3">
        {topProdukte.map((entry) => <ProductCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container stats">
      <div class="stat">
        <span class="stat__num">{alleProdukte.length}</span>
        <span class="stat__label">Rated products</span>
      </div>
      <div class="stat">
        <span class="stat__num">{anzahlEmpfehlung}</span>
        <span class="stat__label">Clear recommendations</span>
      </div>
      <div class="stat">
        <span class="stat__num">{anzahlDiskussion}</span>
        <span class="stat__label">Deliberately debatable</span>
      </div>
      <div class="stat">
        <span class="stat__num">4</span>
        <span class="stat__label">Transparent score criteria</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta-split">
      <div class="card cta-card">
        <Icon name="github" size={26} />
        <h3>Maintained by the community on GitHub</h3>
        <p>
          Every product is a simple markdown file with clear rating fields. New products,
          corrections or long-term reports come in via pull request – traceable and
          versioned.
        </p>
        <a href="/en/mitmachen" class="btn btn--primary">Contribute</a>
      </div>
      <div class="card cta-card">
        <Icon name="calculator" size={26} />
        <h3>Cost-per-use instead of sticker price</h3>
        <p>
          A €500 device that lasts 20 years is cheaper than four €150 devices that break
          every 3 years. The calculator makes that visible.
        </p>
        <a href="/en/rechner" class="btn btn--ghost">Open the calculator</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: 5rem 0 3.5rem;
    overflow: hidden;
    background:
      radial-gradient(600px 300px at 85% -10%, rgba(247, 147, 26, 0.16), transparent);
  }
  .hero::before {
    content: '₿';
    position: absolute;
    top: -5rem;
    right: -1.5rem;
    font-family: var(--font-display);
    font-size: 24rem;
    font-weight: 700;
    color: var(--color-bronze);
    opacity: 0.05;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
  .hero__inner { position: relative; z-index: 1; max-width: 780px; }
  .hero__actions {
    display: flex;
    gap: 0.9rem;
    margin-top: 1.6rem;
    flex-wrap: wrap;
  }
  .idea-grid { margin-top: 1.5rem; }
  .idea-grid h3 { display: flex; align-items: center; gap: 0.5rem; }
  .idea-grid h3 :global(svg) { color: var(--color-bronze); flex-shrink: 0; }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.8rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .kat-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1.4rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
  }
  .kat-card:hover { border-color: var(--color-bronze); color: var(--color-ink); }
  .kat-card :global(svg) { color: var(--color-bronze); }
  .kat-card__label { font-weight: 700; font-family: var(--font-display); }
  .kat-card__count { font-size: 0.85rem; color: var(--color-ink-soft); }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    text-align: center;
  }
  .stat__num {
    display: block;
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--color-bronze-light);
    font-weight: 700;
  }
  .stat__label { font-size: 0.9rem; color: #cfc7b6; }

  .cta-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .cta-card { display: flex; flex-direction: column; gap: 0.6rem; }
  .cta-card :global(svg) { color: var(--color-bronze); }

  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .cta-split { grid-template-columns: 1fr; }
  }
</style>
