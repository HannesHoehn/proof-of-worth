---
import Icon from './Icon.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer__grid">
    <div>
      <div class="brand brand--footer">
        <Icon name="bitcoin" size={20} />
        <span>Proof of Worth</span>
      </div>
      <p class="footer__claim">{t('footer.claim')}</p>
    </div>

    <div>
      <h4>{t('footer.erkunden')}</h4>
      <ul class="footer__links">
        <li><a href={getRelativeLocaleUrl(lang, '/produkte')}>{t('footer.alleProdukte')}</a></li>
        <li><a href={getRelativeLocaleUrl(lang, '/score-methodik')}>{t('footer.methodik')}</a></li>
        <li><a href={getRelativeLocaleUrl(lang, '/rechner')}>{t('footer.rechner')}</a></li>
      </ul>
    </div>

    <div>
      <h4>{t('footer.mitmachenHeading')}</h4>
      <ul class="footer__links">
        <li><a href={getRelativeLocaleUrl(lang, '/mitmachen')}>{t('footer.produktVorschlagen')}</a></li>
        <li><a href={getRelativeLocaleUrl(lang, '/ueber-uns')}>{t('footer.philosophie')}</a></li>
        <li><a href={getRelativeLocaleUrl(lang, '/unterstuetzen')}>{t('footer.unterstuetzenLink')}</a></li>
      </ul>
    </div>

    <div>
      <h4>{t('footer.projekt')}</h4>
      <ul class="footer__links">
        <li>
          <a href="https://github.com/" target="_blank" rel="noopener noreferrer">
            {t('footer.githubRepo')}
          </a>
        </li>
        <li><a href={getRelativeLocaleUrl(lang, '/impressum')}>{t('footer.impressum')}</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <span>© {year} Proof of Worth · {t('footer.bottom')}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: var(--color-paper-dim);
    padding: 3rem 0 1.5rem;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2rem;
  }
  .brand--footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-paper);
    margin-bottom: 0.6rem;
  }
  .footer__claim {
    color: #b9b2a3;
    font-size: 0.92rem;
    max-width: 32ch;
  }
  .site-footer h4 {
    color: var(--color-paper);
    font-family: var(--font-body);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.8rem;
  }
  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .footer__links a {
    color: #cfc7b6;
    text-decoration: none;
    font-size: 0.92rem;
  }
  .footer__links a:hover { color: var(--color-bronze-light); }
  .footer__bottom {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.82rem;
    color: #8f8878;
  }
  @media (max-width: 780px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .footer__grid { grid-template-columns: 1fr; }
  }
</style>
