    <g fill="#f7931a">
      <circle cx="55" cy="72" r="3"/>
      <circle cx="68" cy="70" r="3"/>
      <circle cx="81" cy="70" r="3"/>
      <circle cx="94" cy="73" r="3"/>
    </g>
  `,
  'dyson-akkusauger': `
    <g stroke="#1c1a17" stroke-width="3.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d="M55 30 L85 30 L88 55 L52 55 Z"/>
      <path d="M88 40 Q108 42 108 55 Q108 66 92 66 L88 66"/>
      <line x1="70" y1="55" x2="70" y2="95"/>
      <rect x="55" y="95" width="30" height="10" rx="3"/>
    </g>
    <path d="M108 46 Q116 46 116 54" stroke="#f7931a" stroke-width="3" fill="none" stroke-linecap="round"/>
  `,
};

const content = illustrations[slug] ?? `
  <g stroke="#1c1a17" stroke-width="3.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M30 55 L70 35 L110 55 L70 75 L30 55Z"/>
    <path d="M30 55 L30 95 L70 115 L70 75"/>
    <path d="M110 55 L110 95 L70 115"/>
  </g>
`;
---

<svg
  viewBox="0 0 140 140"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role="img"
  aria-hidden="true"
>
  <Fragment set:html={content} />
</svg>
